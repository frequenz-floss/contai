#!/bin/sh
set -eu

tool=

if test $# -gt 0; then
	tool=$1
	shift
fi

enable_rtk() {
	if ! command -v rtk > /dev/null 2>&1; then
		return
	fi

	if test "$tool" = "rtk"; then
		return
	fi

	# RTK writes Claude's global files atomically and expects this directory to
	# exist when the persistent home is new.
	mkdir -p "$HOME/.claude"

	run_rtk_init init -g --auto-patch
	run_rtk_init init -g --gemini --auto-patch
	run_rtk_init init -g --codex
	run_rtk_init init -g --opencode --auto-patch

	# RTK's Copilot integration is project-scoped, so only install it when
	# launching Copilot and write it into the current project's root.
	if test "$tool" = "copilot"; then
		enable_rtk_copilot
	fi
}

run_rtk_init() {
	# Startup must never wait for input: the output is hidden, so a prompt
	# would hang it silently. --auto-patch does not cover every prompt, nor
	# every mode, and new RTK releases keep adding prompts, so opt out of
	# telemetry, read stdin from /dev/null so RTK takes the default answer to
	# anything it asks, and give up after a while in case a prompt bypasses
	# stdin.
	if ! RTK_TELEMETRY_DISABLED=1 timeout 60 rtk "$@" < /dev/null > /dev/null 2>&1; then
		printf 'contai: failed to initialize RTK with: rtk' >&2
		for arg in "$@"; do
			printf ' %s' "$arg" >&2
		done
		printf '\n' >&2
		return 0
	fi

	return 0
}

enable_rtk_copilot() {
	project_dir=$PWD

	if git_root=$(git rev-parse --show-toplevel 2> /dev/null); then
		project_dir=$git_root
	fi

	if ! (
		cd "$project_dir"
		RTK_TELEMETRY_DISABLED=1 timeout 60 rtk init -g --copilot < /dev/null > /dev/null 2>&1
	); then
		printf 'contai: failed to initialize RTK Copilot integration in %s\n' "$project_dir" >&2
	fi
}

enable_rtk

if test -n "$tool"; then
	exec "$tool" "$@"
fi

exec bash
